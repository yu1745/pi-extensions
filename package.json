{
	"name": "@yu1745/pi-extensions",
	"version": "0.1.0",
	"description": "Monorepo of yu1745's pi extensions: web search/reader, vision, provider quota footers, and UX tweaks.",
	"type": "module",
	"license": "MIT",
	"author": "yu1745",
	"packageManager": "pnpm@11.20.0",
	"files": [
		"extensions"
	],
	"scripts": {
		"test": "node scripts/run-tests.mjs",
		"test:commandcode": "node --experimental-transform-types --test --test-concurrency=4 tests/commandcode-*.test.ts tests/commandcode-upstream/test-*.ts",
		"typecheck:commandcode": "tsc -p extensions/commandcode/tsconfig.json"
	},
	"dependencies": {
		"linkedom": "^0.18.13",
		"playwright": "^1.62.1",
		"undici": "^8.10.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@types/node": "^25.9.1",
		"typebox": "1.1.38",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"extensions/clear-new-alias.ts",
			"extensions/codex-timer.ts",
			"extensions/compact-threshold.ts",
			"extensions/status-footer.ts",
			"extensions/inject-resume.ts",
			"extensions/openai-codex-fast.ts",
			"extensions/context-window.ts",
			"extensions/append.ts",
			"extensions/quota-footer.ts",
			"extensions/siliconflow.ts",
			"extensions/commandcode/index.ts",
			"extensions/codebuddy-fp/index.ts",
			"extensions/tokenspeed.ts",
			"extensions/tool-duration.ts",
			"extensions/web-reader-spa/index.ts",
			"extensions/working-bell.ts",
			"extensions/web-search/index.ts",
			"extensions/filter-image-reader.ts",
			"extensions/antigravity/index.ts",
			"extensions/subagents-cost.ts",
			"extensions/deepseek-time-pricing.ts",
			"extensions/codex-cost.ts",
			"extensions/chinese-bang-bash.ts",
			"extensions/smart-ctrl-c.ts"
		]
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"zai",
		"web-search",
		"vision",
		"web-reader-spa",
		"web-reader-local",
		"playwright"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yu1745/pi-extensions.git"
	}
}
